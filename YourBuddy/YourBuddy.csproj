<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(MSBuildThisFileDirectory)lib</GameManagedDir>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>YourBuddy</AssemblyName>
    <RootNamespace>YourBuddy</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.0.9</Version>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unused usings) only runs in build with doc generation on; the XML itself is not shipped. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NPC.Core, the shared NPC library: its project when the repositories sit side by side,
         else the DLL in lib/ (lib/README.md). Neither is copied to the output: NPC.Core is its
         own plugin in BepInEx/plugins. -->
    <NpcCoreProject>$(MSBuildThisFileDirectory)..\..\npc-core-inhl\NPC.Core\NPC.Core.csproj</NpcCoreProject>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(NpcCoreProject)')">
    <ProjectReference Include="$(NpcCoreProject)">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(NpcCoreProject)')">
    <Reference Include="NPC.Core">
      <HintPath>lib\NPC.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\Assembly-CSharp.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\Newtonsoft.Json.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\FMODUnity.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.AnimationModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.CoreModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.PhysicsModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.IMGUIModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.TextRenderingModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.ImageConversionModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\Unity.InputSystem.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.InputLegacyModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.UI.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\Unity.TextMeshPro.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.27.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The EVA suit skin, applied while the buddy wears a suit: docs/eva.md -->
    <EmbeddedResource Include="Resources\PilotSuit_eva.png" />
    <EmbeddedResource Include="Resources\Meat.bbmodel" />
    <!-- The skin flickers' overlays: docs/anomalies.md -->
    <EmbeddedResource Include="Resources\FlickerSmile.png" />
    <EmbeddedResource Include="Resources\FlickerFlesh.png" />
    <!-- The anomalies' own sounds, by prefix: docs/anomalies.md#5-sounds -->
    <EmbeddedResource Include="Resources\Sounds\*.mp3" />
  </ItemGroup>

</Project>
